# Copy to .env and adjust. Placeholders only - never commit real secrets.

# --- Answer generation -------------------------------------------------------
# auto = use Claude when ANTHROPIC_API_KEY is set, otherwise the labelled MOCK MODE.
LLM_PROVIDER=auto
# Leave empty for MOCK MODE. Placeholder values are ignored.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=60
# Server-side fallback when a request is declined by safety classifiers (Claude API only).
LLM_SERVER_FALLBACKS=true

# --- Embeddings (local; no document text leaves the host) ---------------------
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MODEL_CACHE_DIR=.models

# --- Retrieval / chunking ------------------------------------------------------
RETRIEVAL_TOP_K=6
CHUNK_SIZE_CHARS=900
CHUNK_OVERLAP_CHARS=150
MIN_DENSE_SCORE=0.62
MIN_TERM_COVERAGE=0.5

# --- Uploads ---------------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=200
MAX_EXTRACTED_CHARS=2000000
PARSE_TIMEOUT_SECONDS=20
# quarantine (store, never index, admin-visible) or reject
SECRET_POLICY=quarantine

# --- API protection ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
QA_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=10
SESSION_TTL_MINUTES=480
AUDIT_RETENTION_DAYS=90

# --- Storage & demo -------------------------------------------------------------
DATA_DIR=backend/data
# Shared password for the synthetic demo users (emma, eli, sam, hana, adam). Change it.
DEMO_PASSWORD=change-me-demo-password
SEED_SAMPLE_DOCS=true
# Load adversarial test fixtures (prompt injection + contradictory docs) into the demo.
SEED_TEST_FIXTURES=false
